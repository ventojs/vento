{
  "name": "ventojs",
  "version": "2.4.2",
  "description": "🌬 A minimal but powerful template engine",
  "keywords": [
    "template engine"
  ],
  "homepage": "https://vento.js.org/",
  "bugs": {
    "url": "https://github.com/ventojs/vento/issues"
  },
  "license": "MIT",
  "author": "Óscar Otero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventojs/vento.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/mod.d.ts",
      "import": "./mod.js"
    },
    "./*.js": {
      "types": "./*.d.ts",
      "import": "./*.js"
    },
    "./*.ts": {
      "types": "./*.d.ts",
      "import": "./*.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && tsc -p . && cp *-vento.js build",
    "bench:render": "node bench/render.bench.ts",
    "bench:full": "node bench/full.bench.ts",
    "bench:compilation": "node bench/compilation.bench.ts",
    "test": "vitest run test",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "fmt": "oxfmt ."
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@11ty/nunjucks": "4.0.0-alpha.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "@types/pug": "^2.0.10",
    "edge.js": "^6.5.1",
    "ejs": "^7.0.2",
    "eta": "^4.6.0",
    "liquidjs": "^10.30.1",
    "nunjucks": "^3.2.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pug": "^3.0.4",
    "tinybench": "^6.2.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
